.claude/
node_modules/
.wrangler/

# Arquivos de trabalho intermediários dos vídeos (finn-social/ads/gera-video-*.mjs)
# — a gravação bruta do Playwright e a versão ainda sem áudio. O resultado
# final (sem "-silencioso" no nome) é o que entra no repositório.
finn-social/ads/_tmp_video/
finn-social/ads/*-silencioso.mp4

# Segredos nunca entram no repositório — eles ficam no Cloudflare, via
# "wrangler secret put". Hoje nenhum .env existe aqui; isto é o guarda-corpo
# pra que um arquivo criado por engano não vá parar num commit público.
.env
.env.*
!.env.example
*.pem
*.key
