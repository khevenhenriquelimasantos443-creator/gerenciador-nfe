{
  "namespace": "hud",

  "cl_minimapa": {
    "type": "panel",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -2, 2 ],
    "size": [ "100%cm", "100%cm" ],
    "layer": 20,
    "bindings": [
      { "binding_name": "#hud_title_text_string", "binding_type": "global" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - 'clmapa:') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "fundo": {
          "type": "image",
          "texture": "textures/ui/hud_tip_text_background",
          "size": [ "100%sm + 4px", "100%sm + 4px" ],
          "alpha": 0.7
        }
      },
      {
        "texto": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "text": "#texto",
          "localize": false,
          "layer": 1,
          "color": [ 1, 1, 1 ],
          "shadow": false,
          "text_alignment": "center",
          "font_scale_factor": 0.6,
          "bindings": [
            { "binding_name": "#hud_title_text_string", "binding_type": "global" },
            {
              "binding_type": "view",
              "source_property_name": "(#hud_title_text_string - 'clmapa:')",
              "target_property_name": "#texto"
            }
          ]
        }
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [ { "cl_minimapa@hud.cl_minimapa": {} } ]
      }
    ]
  },

  "hud_title_text": {
    "bindings": [
      { "binding_name": "#hud_title_text_string", "binding_type": "global" },
      {
        "binding_type": "view",
        "source_property_name": "((#hud_title_text_string - 'clmapa:') = #hud_title_text_string)",
        "target_property_name": "#visible"
      }
    ]
  }
}
