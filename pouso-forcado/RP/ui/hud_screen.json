            },
            {
              "binding_type": "view",
              "source_property_name": "(#hud_title_text_string - 'clmapa:')",
              "target_property_name": "#texto"
            }
          ]
        }
      },
      {
        "info": {
          "type": "label",
          "anchor_from": "bottom_middle",
