{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "rootDir": "scripts",
    "outDir": "BP/scripts",
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts"]
}
