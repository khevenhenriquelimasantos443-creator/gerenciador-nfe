{
  "format_version": "1.26.30",
  "minecraft:block": {
    "description": {
      "identifier": "cl:tronco_cascaender",
      "menu_category": {
        "category": "items"
      },
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": [
            "minecraft:block_face"
          ]
        }
      }
    },
    "components": {
